# ValueScope configuration. Copy to .env for local use, or set these as
# environment variables in Railway (Project → Variables). Never commit real keys.
#
# EVERYTHING IS OPTIONAL except the OpenRouter key (needed only for AI
# narratives — the app runs without it using deterministic text). The data
# pipeline is fully autonomous and keyless with NO single point of failure:
# SEC EDGAR fundamentals; prices via Yahoo -> Cboe delayed quotes; rates via
# FRED -> official US Treasury yield curve -> Yahoo; FX via Yahoo -> er-api ->
# ECB; unemployment/CPI via FRED -> BLS public API.

# --- AI (OpenRouter) ---------------------------------------------------------
# Comma-separated keys are supported (rotates on auth failure).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GLM model slug on OpenRouter (verified live 2026-07).
OPENROUTER_MODEL=z-ai/glm-5.2
# Provider routing slug — StreamLake serves GLM 5.2 with implicit prompt
# caching (cache reads bill at ~19% of the prompt rate, verified live).
OPENROUTER_PROVIDER=streamlake
# Ceiling on completion tokens (reasoning disabled, so this is generous).
OPENROUTER_MAX_TOKENS=20000
# 0 = greedy decoding: narration must restate engine numbers verbatim.
OPENROUTER_TEMPERATURE=0
VALUESCOPE_AI_ENABLED=true

# --- Data (all optional — autonomous defaults) --------------------------------
# Optional last-resort market-data source (free tier ~25 requests/day). The
# keyless chain (Yahoo -> Cboe delayed; er-api/ECB FX) carries everything
# without it — set this only for extra redundancy.
# ALPHAVANTAGE_API_KEY=your-key-here
# Tickers to scan. Default: ~130 names across the US, Europe (native ESEF
# coverage: LVMH, Airbus, Air Liquide, Adyen, ...) and emerging markets
# (foreign names via their US-listed ADRs; banks/insurers excluded — FCFF
# DCF misvalues financials). Any other SEC filer is analyzable on demand via
# the search bar. Note: this is a ticker LIST, not a count
# (VALUESCOPE_MC_RUNS is the Monte Carlo draw count, unrelated to universe
# size). Expansion tokens compose with plain tickers:
#   SP500 -> current S&P 500 constituents (ex-financials/real-estate)
#   EU    -> the scannable European ESEF names
# Examples:
#   VALUESCOPE_UNIVERSE=SP500,EU          # ~430 US + ~35 EU names
#   VALUESCOPE_UNIVERSE=AAPL,MC.PA,TSM    # fully custom list
# First warm of a 400+ universe takes ~30-60 min (adaptive source pacing);
# results stream into the feed as they complete and persist across restarts.
# VALUESCOPE_UNIVERSE=SP500,EU
# SEC asks for a contact string in the User-Agent (works without changing it).
# VALUESCOPE_SEC_UA=ValueScope research your-email@example.com

# --- Engine ------------------------------------------------------------------
VALUESCOPE_MC_RUNS=10000

# PORT is injected by Railway automatically; only set locally if needed.
# PORT=8000
